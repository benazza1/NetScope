"""
fake_domains = [
    "google.com",
    "cloudflare.com",
    "github.com",
    "openai.com",
    "youtube.com"
]

fake_protocols = ["DNS", "HTTP", "TCP"]

fake_ips = [
    "8.8.8.8",
    "1.1.1.1",
    "142.250.190.78",
    "172.217.16.142"
]
kdef help_menu():
    print(f"""
{GREEN}Usage:{RESET}
  python3 netscope.py           Run full analysis
  python3 netscope.py DNS       Filter DNS packets
  python3 netscope.py HTTP      Filter HTTP packets
  python3 netscope.py TCP       Filter TCP packets
  python3 netscope.py --help    Show help menu
""")

# help
if len(sys.argv) > 1 and sys.argv[1] == "--help":
    print(banner)
    hel live mode
live_mode = False

if len(sys.argv) > 1 and sys.argv[1].lower() == "live":
    live_mode = True
packets = []

for _ in range(10):

    src = "192.168.1.10"
    dst = random.choice(fake_ips)
    proto = random.choice(fake_protocols)
    data = random.choice(fake_domains)

    packet = f"{src} -> {dst} | {proto} | {data}"

    packets.append(packet)

for i, p in enumerate(packets, start=1):

    p = p.strip()

    if not p:
        continue

    src, rest = p.split(" -> ")
    dst, proto, data = rest.split(" | ")

    if filter_proto and proto.upper() != filter_proto:
        continue

    if proto == "DNS":
        dns_count += 1
        color = CYAN

    elif proto == "HTTP":
        http_count += 1
        color = GREEN

    else:
        tcp_count += 1
        color = YELLOW

    print(f"{color}[{i}] PACKET{RESET}")
    print(f"SRC   : {src}")
    print(f"DST   : {dst}")
    print(f"PROTO : {proto}")
    print(f"DATA  : {data}")
    print("-" * 60)

if live_mode:
    print(f"{RED}[LIVE MODE ENABLED]{RESET}")
    if live_mode:
       time.sleep(1)
else:
    time.sleep(0.4)

print(f"\n{CYAN}📊 SUMMARY{RESET}")
print(f"DNS  : {dns_count}")
print(f"HTTP : {http_count}")
print(f"TCP  : {tcp_count}")

print(f"\n{GREEN}✔ Analysis Complete 🚀{RESET}")
